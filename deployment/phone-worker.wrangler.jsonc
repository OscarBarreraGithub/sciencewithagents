{
  // Inert template. scripts/phone-cloudflare-setup.mjs prepares a private config.
  "name": "dock-phone-disabled",
  "main": "phone-worker.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "PHONE_PUBLIC_ORIGIN": "" },
  "vpc_services": [
    { "binding": "PAIRED_APP", "service_id": "00000000-0000-0000-0000-000000000000" },
  ],
  "dev": { "ip": "127.0.0.1" },
  "observability": { "enabled": false },
}
