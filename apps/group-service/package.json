{
  "name": "@dock/group-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "types": "WRANGLER_SEND_METRICS=false wrangler types worker-configuration.d.ts --include-runtime=false && prettier --write worker-configuration.d.ts",
    "test": "WRANGLER_SEND_METRICS=false vitest run",
    "config:check": "node scripts/check-config.mjs"
  },
  "dependencies": {
    "@dock/shared": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@cloudflare/workers-types": "5.20261006.1",
    "vitest": "4.1.11",
    "wrangler": "4.147.0",
    "ajv": "8.20.0",
    "jsonc-parser": "3.3.1"
  }
}
