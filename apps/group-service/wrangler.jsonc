{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dock-group-service-disabled",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "HOSTING_MODE": "disabled",
    "GROUP_SETUP_HASH": "",
    "HOSTING_ORIGIN": "",
    "HOSTING_APPROVAL_HASH": "",
    "GROUP_BETA_SERVICE_ID": "",
    "GROUP_BETA_KEYS": "",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GROUPS",
        "class_name": "GroupMembership",
      },
    ],
  },
  "migrations": [
    {
      "tag": "membership-v1",
      "new_sqlite_classes": ["GroupMembership"],
    },
  ],
  "dev": {
    "ip": "127.0.0.1",
  },
  "observability": {
    "enabled": false,
  },
}
